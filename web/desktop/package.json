{
  "name": "hollowmoor",
  "productName": "Hollowmoor",
  "version": "1.0.0",
  "description": "Hollowmoor — a 1v4 horror game. The statue only moves when nobody is looking.",
  "author": "Hollowmoor",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "pack:win": "npm run prepare-app && electron-packager . Hollowmoor --platform=win32 --arch=x64 --out=out --overwrite --asar --icon=build/icon.ico --ignore=\"^/(out|build|prepare\\.mjs|README\\.md)\" --app-copyright=\"Hollowmoor\"",
    "pack:linux": "npm run prepare-app && electron-packager . Hollowmoor --platform=linux --arch=x64 --out=out --overwrite --asar --ignore=\"^/(out|build|prepare\\.mjs|README\\.md)\"",
    "dist": "npm run prepare-app && electron-builder --publish never"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "moor.hollow.game",
    "productName": "Hollowmoor",
    "files": ["main.js", "preload.js", "app/**"],
    "directories": { "output": "out", "buildResources": "build" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "Hollowmoor-Setup-${version}.exe" },
    "portable": { "artifactName": "Hollowmoor-${version}-portable.exe" },
    "mac": { "target": ["zip"], "icon": "build/icon.png", "category": "public.app-category.games", "identity": null },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Game" }
  }
}
